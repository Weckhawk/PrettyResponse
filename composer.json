{
    "name": "weckhawk/pretty-response",
    "description": "A fluent and consistent API response builder for Laravel applications.",
    "keywords": ["laravel", "api", "response", "json", "http"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Weckhawk",
            "email": "weckhawk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/pagination": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Weckhawk\\PrettyResponse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weckhawk\\PrettyResponse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weckhawk\\PrettyResponse\\PrettyResponseServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage/html",
        "stan": "phpstan analyse",
        "pint": "pint",
        "pint-test": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
